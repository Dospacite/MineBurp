    "allow-repeater-tab-delete",
    "allow-protocol-versions",
    "allow-schema-validate",
    "allow-launcher-instances",
    "allow-launcher-launch",
    "allow-client-assist-status",
    "allow-launcher-client-assist-configure",
    "allow-auth-begin",
    "allow-auth-complete",
    "allow-auth-session",
    "allow-auth-refresh",
    "allow-auth-sign-out"
