    "allow-filter-vocabulary",
    "allow-filter-validate",
    "allow-packet-detail",
    "allow-packet-bytes",
    "allow-inspect-bytes",
    "allow-packet-layout",
    "allow-packet-layout-stored",
    "allow-field-edit",
    "allow-proxy-sessions",
    "allow-intercept-settings-get",
