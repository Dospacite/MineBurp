  "permissions": [
    "allow-replacement-rule-preview",
    "allow-payload-generate",
    "allow-decoder-transform",
    "allow-workbench-document-get",
    "allow-workbench-document-save",
    "allow-channel-stats",
    "allow-packet-field-values",
    "allow-intruder-plan",
    "allow-sequencer-analyze",
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-app-capabilities",
    "allow-setup-check",
    "allow-decrypt-mode-status",
    "allow-decrypt-mode-set",
    "allow-capture-start",
    "allow-capture-stop",
    "allow-capture-stats",
    "allow-project-create",
    "allow-project-open",
    "allow-project-save-as",
    "allow-project-current",
    "allow-lab-listener-active",
    "allow-lab-listener-stop",
    "allow-lab-listener-start",
    "allow-project-scope-set",
    "allow-project-scope-get",
    "allow-project-recovered-save-as",
