{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineBurp",
  "identifier": "tools.mineburp.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecar && npm run build:agent && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "MineBurp",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Minecraft protocol workbench",
    "resources": {
      "../agent/build/mineburp-agent.jar": "resources/mineburp-agent.jar"
    },
    "externalBin": [
      "binaries/mineburp-mcp"
    ],
    "linux": {
      "deb": {
        "depends": [
          "wireshark-common"
        ]
      }
    }
  }
}
